// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GithubUser {
  id                     Int        @id @default(autoincrement())
  githubId               BigInt     @unique
  username               String     @unique
  avatarUrl              String?
  bio                    String?
  followers              Int
  following              Int
  publicRepos            Int
  lastSyncedAt           DateTime
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  repositories           Repository[]
  stats                  UserStats?
  gitProfileCreated_at   DateTime 
  gitProfileUpdated_at   DateTime 
  gitProfileUrl          String
}

model Repository {
  id           Int    @id @default(autoincrement())
  githubRepoId BigInt @unique
  name         String
  language     String?
  stars        Int
  forks        Int
  userId       Int
  user         GithubUser @relation(fields: [userId], references: [id])
}

model UserStats {
  userId       Int   @id
  totalStars   Int
  totalForks   Int
  topLanguages Json
  user         GithubUser @relation(fields: [userId], references: [id])
}